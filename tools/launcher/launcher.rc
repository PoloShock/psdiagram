#include <winver.h>

#define LAUNCHER_VERSION     2,0,0,0
#define LAUNCHER_VERSION_STR "2.0.0.0"

1 ICON "attempt5.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    LAUNCHER_VERSION
PRODUCTVERSION LAUNCHER_VERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Miroslav Bartyzal"
            VALUE "FileDescription",  "PS Diagram launcher"
            VALUE "FileVersion",      LAUNCHER_VERSION_STR
            VALUE "InternalName",     "PS Diagram"
            VALUE "LegalCopyright",   "Copyright (C) Miroslav Bartyzal"
            VALUE "OriginalFilename", "PS Diagram.exe"
            VALUE "ProductName",      "PS Diagram"
            VALUE "ProductVersion",   LAUNCHER_VERSION_STR
            VALUE "Comments",         "Starts psdiagram.jar with the bundled Java runtime. https://www.psdiagram.cz"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
